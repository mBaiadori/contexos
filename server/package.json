{
  "name": "context-os-server",
  "version": "1.0.17",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude 'dist/**' --exclude 'projects/**' --exclude '../projects/**' src/server.ts",
    "test": "node ../scripts/run-tests.mjs",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc && node ../scripts/copy-schemas.mjs",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.3",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.2.0",
    "@fastify/sensible": "^6.0.3",
    "@fastify/static": "^10.1.7",
    "@google/generative-ai": "^0.22.0",
    "@napi-rs/keyring": "^2.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "chokidar": "^4.0.3",
    "diff": "^9.0.0",
    "fastify": "^5.2.1",
    "openai": "^4.85.4",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
