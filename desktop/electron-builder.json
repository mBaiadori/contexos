{
  "appId": "com.contextos.desktop",
  "productName": "Contexos",
  "copyright": "Copyright © 2026 Contexos Team",
  "directories": {
    "output": "release",
    "buildResources": "resources"
  },
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "../server/dist",
      "to": "server",
      "filter": ["**/*"]
    },
    {
      "from": "../frontend/dist",
      "to": "ui",
      "filter": ["**/*"]
    }
  ],
  "asar": true,
  "asarUnpack": [
    "**/node_modules/bytenode/**/*",
    "**/node_modules/@napi-rs/**/*"
  ],
  "mac": {
    "icon": "resources/icon.icns",
    "category": "public.app-category.developer-tools",
    "target": [
      {
        "target": "pkg",
        "arch": ["arm64", "x64"]
      },
      {
        "target": "dmg",
        "arch": ["arm64", "x64"]
      },
      {
        "target": "zip",
        "arch": ["arm64", "x64"]
      }
    ],
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "identity": null
  },
  "pkg": {
    "scripts": "pkg-scripts",
    "installLocation": "/Applications",
    "allowCurrentUserHome": true,
    "allowRootDirectory": true
  },
  "win": {
    "icon": "resources/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "extraResources": [
      {
        "from": "resources/git-win",
        "to": "git",
        "filter": ["**/*"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "include": "scripts/installer.nsh"
  },
  "linux": {
    "icon": "resources/icon.png",
    "target": [
      "AppImage",
      "deb"
    ],
    "category": "Development"
  },
  "publish": {
    "provider": "github",
    "owner": "mBaiadori",
    "repo": "project-boilerplate"
  }
}
